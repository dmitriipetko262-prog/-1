<div class="cartOverlay" id="cartOverlay"></div>
<aside class="cartDrawer" id="cartDrawer">
  <div class="cdHead">
    <b>Корзина</b>
    <button id="cartClose" title="Закрыть">✕</button>
  </div>
  <div class="cdList" id="cartList"></div>
  <div class="cdFoot">
    <div class="cdField">
      <input id="coName" placeholder="Имя или организация">
      <input id="coPhone" type="tel" placeholder="Телефон *">
      <div class="coRadio">
        <label><input type="radio" name="dvr" value="Самовывоз со склада" checked> Самовывоз со склада</label>
        <label><input type="radio" name="dvr" value="Транспортная компания (СДЭК / ПЭК / Деловые Линии)"> Транспортная компания (СДЭК / ПЭК / Деловые Линии)</label>
      </div>
      <textarea id="coMsg" rows="2" placeholder="Комментарий: город, удобное время..."></textarea>
    </div>
    <div class="cdNote">💳 Оплата — по счёту для юридических лиц. Менеджер подтвердит наличие и выставит счёт после заявки.</div>
    <button class="btnSend" id="cartSend">Отправить заявку</button>
    <button class="btnClear" id="cartClear">Очистить корзину</button>
  </div>
</aside>
<div id="cdHover"><img src="" alt="Фото товара"></div>
<div class="buyPop" id="buyPop" role="dialog" aria-live="polite">
  <div class="bmsg">Товар добавлен в корзину</div>
  <div class="brow">
    <button class="bgo" id="buyGo">🛒 Перейти в корзину</button>
    <button class="bcont" id="buyCont">Продолжить покупку</button>
  </div>
</div>

<script>
document.getElementById('year').textContent = new Date().getFullYear();

// Фильтр карточек по типам
const chips = document.querySelectorAll('.chip');
const cards = document.querySelectorAll('.ccard');
chips.forEach(ch => ch.addEventListener('click', () => {
  chips.forEach(c => c.classList.remove('active'));
  ch.classList.add('active');
  const f = ch.dataset.f;
  cards.forEach(card => {
    card.style.display = (f === 'all' || card.dataset.cat === f) ? '' : 'none';
  });
}));

// Карусели фото: только ручное перелистывание стрелками (без авторотации)
document.querySelectorAll('.pic.car').forEach(car => {
  const track = car.querySelector('.track');
  const imgs = track.querySelectorAll('img');
  const dots = car.querySelectorAll('.dots i');
  const n = imgs.length;
  let i = 0;
  function go(k){
    i = ((k % n) + n) % n;
    track.style.transform = 'translateX(-' + (i * 100) + '%)';
    dots.forEach((d, di) => d.classList.toggle('on', di === i));
  }
  car.querySelector('.next').addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); go(i + 1); });
  car.querySelector('.prev').addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); go(i - 1); });
});

// Корзина (localStorage) + кнопка «В корзину»
const WA_ORDER_PHONE = '79288807335'; // WhatsApp для заявок из корзины
const CART_KEY = 'ak23_cart';
function getCart(){
  try {
    const c = JSON.parse(localStorage.getItem(CART_KEY)) || [];
    return c.map(x => (typeof x === 'string') ? { n: x, q: 1 } : x); // миграция старого формата
  } catch(e){ return []; }
}
function saveCart(c){ localStorage.setItem(CART_KEY, JSON.stringify(c)); renderCount(); }
function renderCount(){ const el = document.getElementById('cartCount'); if (el) el.textContent = getCart().reduce((s, x) => s + x.q, 0); }

// Счётчик количества на карточке (− / +, можно ввести вручную)
document.querySelectorAll('.qty').forEach(box => {
  const inp = box.querySelector('.qv');
  const clamp = () => { let v = parseInt(inp.value, 10); if (isNaN(v) || v < 1) v = 1; if (v > 999) v = 999; inp.value = v; };
  box.querySelector('.qm').addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); inp.value = +inp.value - 1; clamp(); });
  box.querySelector('.qp').addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); inp.value = +inp.value + 1; clamp(); });
  inp.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); });
  ['focus','keydown','input'].forEach(ev => inp.addEventListener(ev, e => e.stopPropagation()));
  inp.addEventListener('change', clamp);
});

// Клик по ценнику «Купить»: товар в корзину + сообщение с выбором
const buyPop = document.getElementById('buyPop');
function closeBuyPop(){ buyPop.classList.remove('open'); }
document.querySelectorAll('.buybtn').forEach(btn => btn.addEventListener('click', e => {
  e.preventDefault(); e.stopPropagation();
  const c = getCart();
  const img = btn.dataset.img || 'images/compressor.jpg';
  const it = c.find(x => x.n === btn.dataset.item);
  if (it){ it.q += 1; if (btn.dataset.img) it.img = btn.dataset.img; }
  else c.push({ n: btn.dataset.item, q: 1, img: img });
  saveCart(c);
  buyPop.querySelector('.bmsg').textContent = '«' + btn.dataset.item + '» добавлен в корзину. Что делаем дальше?';
  buyPop.classList.add('open');
}));
document.getElementById('buyGo').addEventListener('click', () => { closeBuyPop(); openCart(); });
document.getElementById('buyCont').addEventListener('click', closeBuyPop);

document.querySelectorAll('.addcart').forEach(btn => btn.addEventListener('click', e => {
  e.preventDefault(); e.stopPropagation();
  const row = btn.closest('.qtyrow');
  const qtyEl = row ? row.querySelector('.qv') : null;
  const qty = qtyEl ? Math.min(999, Math.max(1, parseInt(qtyEl.value, 10) || 1)) : 1;
  const c = getCart();
  const img = btn.dataset.img || 'images/compressor.jpg';
  const it = c.find(x => x.n === btn.dataset.item);
  if (it){ it.q += qty; if (btn.dataset.img) it.img = btn.dataset.img; }
  else c.push({ n: btn.dataset.item, q: qty, img: img });
  saveCart(c);
  const old = btn.textContent;
  btn.textContent = '✓ Добавлено: ' + qty + ' шт.';
  setTimeout(() => { btn.textContent = old; }, 1600);
}));
// Выезжающее окно корзины
const drawer = document.getElementById('cartDrawer');
const overlay = document.getElementById('cartOverlay');
function openCart(){ renderList(); drawer.classList.add('open'); overlay.classList.add('open'); }
function closeCart(){ drawer.classList.remove('open'); overlay.classList.remove('open'); hideThumb(); }
function renderList(){
  const c = getCart();
  const box = document.getElementById('cartList');
  if (!c.length){
    box.innerHTML = '<div class="cdEmpty">Корзина пока пуста.<br>Наведите на карточку товара,<br>выберите количество<br>и нажмите «В корзину».</div>';
    return;
  }
  box.innerHTML = c.map((x, i) =>
    '<div class="cdItem"><span class="cdThumb" data-img="' + (x.img || 'images/compressor.jpg') + '" title="Фото товара">' +
    '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-4.5-4.5L9 18"/></svg></span>' +
    '<span class="nm">' + (i + 1) + '. ' + x.n + '</span>' +
    '<div class="cdQty"><button data-a="m" data-i="' + i + '" title="Уменьшить">−</button><span>' + x.q + ' шт</span><button data-a="p" data-i="' + i + '" title="Увеличить">+</button></div>' +
    '<button class="cdDel" data-a="d" data-i="' + i + '" title="Удалить">✕</button></div>').join('') +
    '<div class="cdTotal">Итого: <b>' + c.reduce((s, x) => s + x.q, 0) + ' шт.</b></div>';
  box.querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
    const cc = getCart();
    const i = +b.dataset.i;
    if (b.dataset.a === 'd'){ cc.splice(i, 1); }
    else if (b.dataset.a === 'p'){ cc[i].q = Math.min(999, cc[i].q + 1); }
    else { cc[i].q -= 1; if (cc[i].q < 1) cc.splice(i, 1); }
    saveCart(cc); renderList();
  }));
  bindThumbs(box);
}

// Мини-фото товара при наведении на значок в корзине
const hoverBox = document.getElementById('cdHover');
function showThumb(t){
  hoverBox.querySelector('img').src = t.dataset.img;
  const r = t.getBoundingClientRect();
  const w = 180, h = 180;
  let left = r.left - 8;
  if (left + w > window.innerWidth - 8) left = window.innerWidth - w - 8;
  if (left < 8) left = 8;
  let top = r.bottom + 8;
  if (top + h > window.innerHeight) top = Math.max(8, r.top - h - 8);
  hoverBox.style.left = left + 'px';
  hoverBox.style.top = top + 'px';
  hoverBox.style.display = 'block';
}
function hideThumb(){ hoverBox.style.display = 'none'; }
function bindThumbs(box){
  box.querySelectorAll('.cdThumb').forEach(t => {
    t.addEventListener('mouseenter', function(){ showThumb(t); });
    t.addEventListener('mouseleave', hideThumb);
    t.addEventListener('click', function(){ (hoverBox.style.display === 'block') ? hideThumb() : showThumb(t); });
  });
}
const cartBtn = document.getElementById('cartBtn');
if (cartBtn) cartBtn.addEventListener('click', e => { e.preventDefault(); openCart(); });
document.getElementById('cartClose').addEventListener('click', closeCart);
overlay.addEventListener('click', closeCart);
document.getElementById('cartSend').addEventListener('click', () => {
  const c = getCart();
  if (!c.length) return;
  const fPhone = document.getElementById('coPhone');
  const phone = fPhone.value.trim();
  if (!phone){ fPhone.style.borderColor = '#c0392b'; fPhone.focus(); return; }
  fPhone.style.borderColor = '';
  const name = document.getElementById('coName').value.trim() || '—';
  const dv = document.querySelector('input[name=dvr]:checked').value;
  const comment = document.getElementById('coMsg').value.trim();
  let text = 'Заявка из корзины с сайта:%0A' + c.map((x, i) => encodeURIComponent((i + 1) + '. ' + x.n + ' — ' + x.q + ' шт.')).join('%0A');
  text += '%0A' + encodeURIComponent('Итого: ' + c.reduce((s, x) => s + x.q, 0) + ' шт.');
  text += '%0A——————%0A';
  text += encodeURIComponent('Имя / организация: ' + name) + '%0A';
  text += encodeURIComponent('Телефон: ' + phone) + '%0A';
  text += encodeURIComponent('Получение: ' + dv);
  if (comment) text += '%0A' + encodeURIComponent('Комментарий: ' + comment);
  window.open('https://wa.me/' + WA_ORDER_PHONE + '?text=' + text, '_blank');
  closeCart();
});
document.getElementById('cartClear').addEventListener('click', () => { saveCart([]); renderList(); });
renderCount();
</script>

</body>
</html>
